// DJFFNY.exe : la page du lanceur, integree a l'exe et servie a WebView2 (djffny.cpp, servir).
// Les images, generees avec ChatGPT le 2026-10-30 (lanceur/images/LISEZMOI.txt, prompts compris).
#include <windows.h>

ICONE ICON "images/icone.ico"
PAGE RCDATA "page.html"
ICONE_PNG RCDATA "images/icone_1024.png"
LOGO RCDATA "images/logo_1200x400.png"
ACCUEIL RCDATA "images/accueil_2560x1440.jpg"
FOND RCDATA "images/installation_2560x1440.jpg"
MOD_DEFAUT RCDATA "images/mod_defaut_600x800.jpg"
AUCUN_MOD RCDATA "images/aucun_mod_800x600.png"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "Def Jam: Fight for NY - Recompiled (lanceur)"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductName", "DJFFNY Recompiled"
      VALUE "ProductVersion", "1.1.0"
      VALUE "OriginalFilename", "DJFFNY.exe"
      VALUE "LegalCopyright", "MIT. Non affilie a Electronic Arts."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x40C, 1200
  END
END
